\u000d\u000a    create table Artiste (\u000d\u000a        genreMusical_id bigint,\u000d\u000a        id bigint not null,\u000d\u000a        biographie varchar(2000),\u000d\u000a        nom varchar(255) not null,\u000d\u000a        photoUrl varchar(255),\u000d\u000a        primary key (id)\u000d\u000a    )
\u000d\u000a    create table CategorieTicket (\u000d\u000a        prix numeric(38,2) not null,\u000d\u000a        quantiteDisponible integer not null,\u000d\u000a        quantiteTotale integer not null,\u000d\u000a        evenement_id bigint,\u000d\u000a        id bigint not null,\u000d\u000a        libelle varchar(255) not null,\u000d\u000a        primary key (id)\u000d\u000a    )
