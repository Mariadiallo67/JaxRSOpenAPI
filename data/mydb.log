\u000d\u000a    create table Evenement (\u000d\u000a        capaciteTotale integer not null,\u000d\u000a        dateDebut timestamp(6),\u000d\u000a        dateFin timestamp(6),\u000d\u000a        datePublication timestamp(6),\u000d\u000a        id bigint not null,\u000d\u000a        lieu_id bigint,\u000d\u000a        organisateur_id bigint,\u000d\u000a        description varchar(3000),\u000d\u000a        statut varchar(255) not null check (statut in ('EN_ATTENTE_VALIDATION','VALIDE','ANNULE','TERMINE')),\u000d\u000a        titre varchar(255) not null,\u000d\u000a        primary key (id)\u000d\u000a    )
