\u000d\u000a    create table Lieu (\u000d\u000a        capacite integer not null,\u000d\u000a        id bigint not null,\u000d\u000a        adresse varchar(255),\u000d\u000a        nom varchar(255) not null,\u000d\u000a        pays varchar(255),\u000d\u000a        ville varchar(255) not null,\u000d\u000a        primary key (id)\u000d\u000a    )
\u000d\u000a    create table Notification (\u000d\u000a        lu boolean not null,\u000d\u000a        dateEnvoi timestamp(6),\u000d\u000a        destinataire_id bigint,\u000d\u000a        id bigint not null,\u000d\u000a        message varchar(2000) not null,\u000d\u000a        titre varchar(255) not null,\u000d\u000a        type varchar(255) not null check (type in ('NOUVEAU_CONCERT','RAPPEL','ANNULATION','OFFRE','TRANSFERT')),\u000d\u000a        primary key (id)\u000d\u000a    )
\u000d\u000a    create table Organisateur (\u000d\u000a        id bigint not null,\u000d\u000a        nomOrganisation varchar(255),\u000d\u000a        siret varchar(255),\u000d\u000a        siteWeb varchar(255),\u000d\u000a        statutOrganisateur varchar(255) check (statutOrganisateur in ('EN_ATTENTE','VALIDE','SUSPENDU')),\u000d\u000a        primary key (id)\u000d\u000a    )
\u000d\u000a    create table Ticket (\u000d\u000a        categorieTicket_id bigint,\u000d\u000a        commande_id bigint,\u000d\u000a        dateAchat timestamp(6),\u000d\u000a        id bigint not null,\u000d\u000a        proprietaire_id bigint,\u000d\u000a        codeQR varchar(255) not null unique,\u000d\u000a        statut varchar(255) not null check (statut in ('VALIDE','UTILISE','ANNULE','TRANSFERE')),\u000d\u000a        primary key (id)\u000d\u000a    )
\u000d\u000a    create table Transfert (\u000d\u000a        dateTransfert timestamp(6),\u000d\u000a        destinataire_id bigint,\u000d\u000a        expediteur_id bigint,\u000d\u000a        id bigint not null,\u000d\u000a        ticket_id bigint unique,\u000d\u000a        statut varchar(255) not null check (statut in ('EN_ATTENTE','ACCEPTE','REFUSE')),\u000d\u000a        primary key (id)\u000d\u000a    )
\u000d\u000a    create table Utilisateur (\u000d\u000a        dateInscription date,\u000d\u000a        id bigint not null,\u000d\u000a        email varchar(255) not null unique,\u000d\u000a        motDePasse varchar(255) not null,\u000d\u000a        nom varchar(255) not null,\u000d\u000a        prenom varchar(255) not null,\u000d\u000a        statutCompte varchar(255) not null check (statutCompte in ('ACTIF','SUSPENDU','BANNI')),\u000d\u000a        telephone varchar(255),\u000d\u000a        primary key (id)\u000d\u000a    )
