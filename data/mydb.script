CREATE SEQUENCE PUBLIC.TRANSFERT_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE SEQUENCE PUBLIC.UTILISATEUR_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE MEMORY TABLE PUBLIC.ADMINISTRATEUR(ID BIGINT NOT NULL PRIMARY KEY,NIVEAU VARCHAR(255),CHECK((PUBLIC.ADMINISTRATEUR.NIVEAU) IN (('SUPER_ADMIN'),('MODERATEUR'))))
CREATE MEMORY TABLE PUBLIC.ARTISTE(GENREMUSICAL_ID BIGINT,ID BIGINT NOT NULL PRIMARY KEY,BIOGRAPHIE VARCHAR(2000),NOM VARCHAR(255) NOT NULL,PHOTOURL VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.CATEGORIETICKET(PRIX NUMERIC(38,2) NOT NULL,QUANTITEDISPONIBLE INTEGER NOT NULL,QUANTITETOTALE INTEGER NOT NULL,EVENEMENT_ID BIGINT,ID BIGINT NOT NULL PRIMARY KEY,LIBELLE VARCHAR(255) NOT NULL)
CREATE MEMORY TABLE PUBLIC.CLIENT(ID BIGINT NOT NULL PRIMARY KEY,ADRESSE VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.CLIENT_GENRE_PREFERENCE(CLIENT_ID BIGINT NOT NULL,GENRE_ID BIGINT NOT NULL,CONSTRAINT FKNJB5A1P4H1XRENU3KVSH3SP45 FOREIGN KEY(CLIENT_ID) REFERENCES PUBLIC.CLIENT(ID))
CREATE MEMORY TABLE PUBLIC.COMMANDE(MONTANTTOTAL NUMERIC(38,2) NOT NULL,CLIENT_ID BIGINT,DATECOMMANDE TIMESTAMP,ID BIGINT NOT NULL PRIMARY KEY,STATUT VARCHAR(255) NOT NULL,CHECK((PUBLIC.COMMANDE.STATUT) IN (('EN_COURS'),('CONFIRMEE'),('ANNULEE'),('REMBOURSEE'))),CONSTRAINT FKVULIM1YO1BVJSXCK8KBLJ7MU FOREIGN KEY(CLIENT_ID) REFERENCES PUBLIC.CLIENT(ID))
CREATE MEMORY TABLE PUBLIC.EVENEMENT(CAPACITETOTALE INTEGER NOT NULL,DATEDEBUT TIMESTAMP,DATEFIN TIMESTAMP,DATEPUBLICATION TIMESTAMP,ID BIGINT NOT NULL PRIMARY KEY,LIEU_ID BIGINT,ORGANISATEUR_ID BIGINT,DESCRIPTION VARCHAR(3000),STATUT VARCHAR(255) NOT NULL,TITRE VARCHAR(255) NOT NULL,CHECK((PUBLIC.EVENEMENT.STATUT) IN (('EN_ATTENTE_VALIDATION'),('VALIDE'),('ANNULE'),('TERMINE'))))
CREATE MEMORY TABLE PUBLIC.EVENEMENT_ARTISTE(ARTISTE_ID BIGINT NOT NULL,EVENEMENT_ID BIGINT NOT NULL,CONSTRAINT FK9W26V7R4JI9ASHMWANG7A72BA FOREIGN KEY(ARTISTE_ID) REFERENCES PUBLIC.ARTISTE(ID),CONSTRAINT FKNCXTIP8L1RX70CLPGREI12II3 FOREIGN KEY(EVENEMENT_ID) REFERENCES PUBLIC.EVENEMENT(ID))
CREATE MEMORY TABLE PUBLIC.GENREMUSICAL(ID BIGINT NOT NULL PRIMARY KEY,LIBELLE VARCHAR(255) NOT NULL,UNIQUE(LIBELLE))
CREATE MEMORY TABLE PUBLIC.LIEU(CAPACITE INTEGER NOT NULL,ID BIGINT NOT NULL PRIMARY KEY,ADRESSE VARCHAR(255),NOM VARCHAR(255) NOT NULL,PAYS VARCHAR(255),VILLE VARCHAR(255) NOT NULL)
CREATE MEMORY TABLE PUBLIC.NOTIFICATION(LU BOOLEAN NOT NULL,DATEENVOI TIMESTAMP,DESTINATAIRE_ID BIGINT,ID BIGINT NOT NULL PRIMARY KEY,MESSAGE VARCHAR(2000) NOT NULL,TITRE VARCHAR(255) NOT NULL,TYPE VARCHAR(255) NOT NULL,CHECK((PUBLIC.NOTIFICATION.TYPE) IN (('NOUVEAU_CONCERT'),('RAPPEL'),('ANNULATION'),('OFFRE'),('TRANSFERT'))))
CREATE MEMORY TABLE PUBLIC.ORGANISATEUR(ID BIGINT NOT NULL PRIMARY KEY,NOMORGANISATION VARCHAR(255),SIRET VARCHAR(255),SITEWEB VARCHAR(255),STATUTORGANISATEUR VARCHAR(255),CHECK((PUBLIC.ORGANISATEUR.STATUTORGANISATEUR) IN (('EN_ATTENTE'),('VALIDE'),('SUSPENDU'))))
CREATE MEMORY TABLE PUBLIC.TICKET(CATEGORIETICKET_ID BIGINT,COMMANDE_ID BIGINT,DATEACHAT TIMESTAMP,ID BIGINT NOT NULL PRIMARY KEY,PROPRIETAIRE_ID BIGINT,CODEQR VARCHAR(255) NOT NULL,STATUT VARCHAR(255) NOT NULL,UNIQUE(CODEQR),CHECK((PUBLIC.TICKET.STATUT) IN (('VALIDE'),('UTILISE'),('ANNULE'),('TRANSFERE'))),CONSTRAINT FKE1XQXNJN0GDS03EVU4MHSA8N0 FOREIGN KEY(CATEGORIETICKET_ID) REFERENCES PUBLIC.CATEGORIETICKET(ID),CONSTRAINT FK45S6SSSJ81BJGSHJMGDL5XDKV FOREIGN KEY(COMMANDE_ID) REFERENCES PUBLIC.COMMANDE(ID),CONSTRAINT FKNN1O6WTS8YQKOUO44Y6K9XTU9 FOREIGN KEY(PROPRIETAIRE_ID) REFERENCES PUBLIC.CLIENT(ID))
CREATE MEMORY TABLE PUBLIC.TRANSFERT(DATETRANSFERT TIMESTAMP,DESTINATAIRE_ID BIGINT,EXPEDITEUR_ID BIGINT,ID BIGINT NOT NULL PRIMARY KEY,TICKET_ID BIGINT,STATUT VARCHAR(255) NOT NULL,UNIQUE(TICKET_ID),CHECK((PUBLIC.TRANSFERT.STATUT) IN (('EN_ATTENTE'),('ACCEPTE'),('REFUSE'))),CONSTRAINT FKJEPHNLMDCMT33W6HSU9ALB4VS FOREIGN KEY(DESTINATAIRE_ID) REFERENCES PUBLIC.CLIENT(ID),CONSTRAINT FK8VG6RQ8YXCL8U0UOSVVNYNMWL FOREIGN KEY(EXPEDITEUR_ID) REFERENCES PUBLIC.CLIENT(ID),CONSTRAINT FKO1B4VJKA51BJBIR4OOUIYHF0G FOREIGN KEY(TICKET_ID) REFERENCES PUBLIC.TICKET(ID))
CREATE MEMORY TABLE PUBLIC.UTILISATEUR(DATEINSCRIPTION DATE,ID BIGINT NOT NULL PRIMARY KEY,EMAIL VARCHAR(255) NOT NULL,MOTDEPASSE VARCHAR(255) NOT NULL,NOM VARCHAR(255) NOT NULL,PRENOM VARCHAR(255) NOT NULL,STATUTCOMPTE VARCHAR(255) NOT NULL,TELEPHONE VARCHAR(255),UNIQUE(EMAIL),CHECK((PUBLIC.UTILISATEUR.STATUTCOMPTE) IN (('ACTIF'),('SUSPENDU'),('BANNI'))))
